    "experiment:ablation": "tsx scripts/ablation.ts",
    "experiment:predator": "tsx scripts/predator-experiment.ts",
    "experiment:predator:merge": "tsx scripts/predator-experiment.ts --merge",
    "figures": "tsx scripts/generate-figures.ts",
    "capture:demo": "tsx scripts/capture-demo.ts",
    "capture:reef-sample": "tsx scripts/reef-sample-capture.ts",
    "capture:reef-sample:game": "tsx scripts/reef-sample-game-capture.ts",
    "capture:reef-variants:gallery": "tsx scripts/reef-variants-gallery-capture.ts",
    "smoke": "tsx scripts/browser-smoke.ts",
    "smoke:demo": "tsx scripts/demo-smoke.ts",
    "smoke:rich": "tsx scripts/rich-default-smoke.ts",
    "accept:observatory": "tsx scripts/observatory-acceptance.ts",
    "benchmark:observatory": "tsx scripts/observatory-benchmark.ts",
    "smoke:glb": "tsx scripts/glb-smoke.ts",
    "perf:fish": "tsx scripts/fish-perf.ts",
    "accept:gpu": "tsx scripts/gpu-acceptance.ts",
    "baseline:phase-f": "tsx scripts/phase-f-baseline.ts",
    "smoke:fish": "tsx scripts/fish-glb-smoke.ts",
    "smoke:predator": "tsx scripts/predator-glb-smoke.ts",
    "smoke:predator:shayu": "tsx scripts/predator-shayu-check.ts",
    "smoke:predator-animation": "tsx scripts/predator-animation-smoke.ts",
    "smoke:predator-animation:main": "tsx scripts/predator-animation-main-smoke.ts",
    "capture:predator-animation": "tsx scripts/predator-animation-capture.ts",
    "video:predator-animation": "tsx scripts/predator-animation-video.ts",
    "smoke:rocks": "tsx scripts/rock-glb-smoke.ts",
    "smoke:rocks-preview": "tsx scripts/rocks-preview-smoke.ts",
    "smoke:coral": "tsx scripts/coral-glb-smoke.ts",
    "smoke:kelp": "tsx scripts/kelp-glb-smoke.ts",
    "smoke:seaweed": "tsx scripts/seaweed-glb-smoke.ts",
