    "quality:benchmark": "tsx scripts/visual-quality-benchmark.ts",
    "benchmark:kelp-refuge": "tsx scripts/kelp-refuge-benchmark.ts",
    "quality:capture": "tsx scripts/visual-quality-capture.ts",
    "capture:lighting": "tsx scripts/lighting-baseline-capture.ts",
    "water:clarity": "tsx scripts/water-clarity.ts",
    "capture:world": "tsx scripts/world-continuity-capture.ts",
    "sim:regression": "tsx scripts/simulation-regression.ts",
    "fixture:checksums": "tsx scripts/checksum-fixture.ts"
